;; ChaCha20 and Poly1305 for chacha20-poly1305@openssh.com.
;;
;; ChaCha20 is the original DJB variant: a 64-bit block counter (state words
;; 12-13) and a 64-bit nonce (words 14-15). Poly1305 is poly1305-donna-32:
;; five 26-bit limbs with 64-bit products.
;;
;; Every function takes byte offsets into the exported memory. Bytes 0-63 are
;; this module's scratch space; the caller lays out the rest.
;;
;; Build: deno task build:wasm (writes chachapoly-wasm.ts)
(module
  (memory (export "memory") 1)

  ;; Poly1305 state between $blocks calls.
  (global $h0 (mut i64) (i64.const 0))
  (global $h1 (mut i64) (i64.const 0))
  (global $h2 (mut i64) (i64.const 0))
  (global $h3 (mut i64) (i64.const 0))
  (global $h4 (mut i64) (i64.const 0))
  (global $r0 (mut i64) (i64.const 0))
  (global $r1 (mut i64) (i64.const 0))
  (global $r2 (mut i64) (i64.const 0))
  (global $r3 (mut i64) (i64.const 0))
  (global $r4 (mut i64) (i64.const 0))

  ;; XORs len bytes at data with the keystream of the 32-byte key at key and
  ;; the 8-byte nonce at nonce, starting at block counter. A partial last
  ;; block goes through scratch bytes 0-63.
  (func (export "chacha20")
    (param $key i32) (param $nonce i32) (param $counter i32) (param $data i32) (param $len i32)
    (local $x0 i32) (local $x1 i32) (local $x2 i32) (local $x3 i32)
    (local $x4 i32) (local $x5 i32) (local $x6 i32) (local $x7 i32)
    (local $x8 i32) (local $x9 i32) (local $x10 i32) (local $x11 i32)
    (local $x12 i32) (local $x13 i32) (local $x14 i32) (local $x15 i32)
    (local $k0 i32) (local $k1 i32) (local $k2 i32) (local $k3 i32)
    (local $k4 i32) (local $k5 i32) (local $k6 i32) (local $k7 i32)
    (local $n0 i32) (local $n1 i32)
    (local $end i32) (local $i i32)

    (local.set $k0 (i32.load (local.get $key)))
    (local.set $k1 (i32.load offset=4 (local.get $key)))
    (local.set $k2 (i32.load offset=8 (local.get $key)))
    (local.set $k3 (i32.load offset=12 (local.get $key)))
    (local.set $k4 (i32.load offset=16 (local.get $key)))
    (local.set $k5 (i32.load offset=20 (local.get $key)))
    (local.set $k6 (i32.load offset=24 (local.get $key)))
    (local.set $k7 (i32.load offset=28 (local.get $key)))
    (local.set $n0 (i32.load (local.get $nonce)))
    (local.set $n1 (i32.load offset=4 (local.get $nonce)))
    (local.set $end (i32.add (local.get $data) (local.get $len)))

    (block $done
      (loop $block
        (br_if $done (i32.ge_u (local.get $data) (local.get $end)))

        (local.set $x0 (i32.const 0x61707865))
        (local.set $x1 (i32.const 0x3320646e))
        (local.set $x2 (i32.const 0x79622d32))
        (local.set $x3 (i32.const 0x6b206574))
        (local.set $x4 (local.get $k0))
        (local.set $x5 (local.get $k1))
        (local.set $x6 (local.get $k2))
        (local.set $x7 (local.get $k3))
        (local.set $x8 (local.get $k4))
        (local.set $x9 (local.get $k5))
        (local.set $x10 (local.get $k6))
        (local.set $x11 (local.get $k7))
        (local.set $x12 (local.get $counter))
        (local.set $x13 (i32.const 0))
        (local.set $x14 (local.get $n0))
        (local.set $x15 (local.get $n1))

        ;; Ten double rounds: four column quarter-rounds, four diagonal ones.
        (local.set $i (i32.const 10))
        (loop $round
          ;; QR(0, 4, 8, 12)
          (local.set $x0 (i32.add (local.get $x0) (local.get $x4)))
          (local.set $x12 (i32.rotl (i32.xor (local.get $x12) (local.get $x0)) (i32.const 16)))
          (local.set $x8 (i32.add (local.get $x8) (local.get $x12)))
          (local.set $x4 (i32.rotl (i32.xor (local.get $x4) (local.get $x8)) (i32.const 12)))
          (local.set $x0 (i32.add (local.get $x0) (local.get $x4)))
          (local.set $x12 (i32.rotl (i32.xor (local.get $x12) (local.get $x0)) (i32.const 8)))
          (local.set $x8 (i32.add (local.get $x8) (local.get $x12)))
          (local.set $x4 (i32.rotl (i32.xor (local.get $x4) (local.get $x8)) (i32.const 7)))
          ;; QR(1, 5, 9, 13)
          (local.set $x1 (i32.add (local.get $x1) (local.get $x5)))
          (local.set $x13 (i32.rotl (i32.xor (local.get $x13) (local.get $x1)) (i32.const 16)))
          (local.set $x9 (i32.add (local.get $x9) (local.get $x13)))
          (local.set $x5 (i32.rotl (i32.xor (local.get $x5) (local.get $x9)) (i32.const 12)))
          (local.set $x1 (i32.add (local.get $x1) (local.get $x5)))
          (local.set $x13 (i32.rotl (i32.xor (local.get $x13) (local.get $x1)) (i32.const 8)))
          (local.set $x9 (i32.add (local.get $x9) (local.get $x13)))
          (local.set $x5 (i32.rotl (i32.xor (local.get $x5) (local.get $x9)) (i32.const 7)))
          ;; QR(2, 6, 10, 14)
          (local.set $x2 (i32.add (local.get $x2) (local.get $x6)))
          (local.set $x14 (i32.rotl (i32.xor (local.get $x14) (local.get $x2)) (i32.const 16)))
          (local.set $x10 (i32.add (local.get $x10) (local.get $x14)))
          (local.set $x6 (i32.rotl (i32.xor (local.get $x6) (local.get $x10)) (i32.const 12)))
          (local.set $x2 (i32.add (local.get $x2) (local.get $x6)))
          (local.set $x14 (i32.rotl (i32.xor (local.get $x14) (local.get $x2)) (i32.const 8)))
          (local.set $x10 (i32.add (local.get $x10) (local.get $x14)))
          (local.set $x6 (i32.rotl (i32.xor (local.get $x6) (local.get $x10)) (i32.const 7)))
          ;; QR(3, 7, 11, 15)
          (local.set $x3 (i32.add (local.get $x3) (local.get $x7)))
          (local.set $x15 (i32.rotl (i32.xor (local.get $x15) (local.get $x3)) (i32.const 16)))
          (local.set $x11 (i32.add (local.get $x11) (local.get $x15)))
          (local.set $x7 (i32.rotl (i32.xor (local.get $x7) (local.get $x11)) (i32.const 12)))
          (local.set $x3 (i32.add (local.get $x3) (local.get $x7)))
          (local.set $x15 (i32.rotl (i32.xor (local.get $x15) (local.get $x3)) (i32.const 8)))
          (local.set $x11 (i32.add (local.get $x11) (local.get $x15)))
          (local.set $x7 (i32.rotl (i32.xor (local.get $x7) (local.get $x11)) (i32.const 7)))
          ;; QR(0, 5, 10, 15)
          (local.set $x0 (i32.add (local.get $x0) (local.get $x5)))
          (local.set $x15 (i32.rotl (i32.xor (local.get $x15) (local.get $x0)) (i32.const 16)))
          (local.set $x10 (i32.add (local.get $x10) (local.get $x15)))
          (local.set $x5 (i32.rotl (i32.xor (local.get $x5) (local.get $x10)) (i32.const 12)))
          (local.set $x0 (i32.add (local.get $x0) (local.get $x5)))
          (local.set $x15 (i32.rotl (i32.xor (local.get $x15) (local.get $x0)) (i32.const 8)))
          (local.set $x10 (i32.add (local.get $x10) (local.get $x15)))
          (local.set $x5 (i32.rotl (i32.xor (local.get $x5) (local.get $x10)) (i32.const 7)))
          ;; QR(1, 6, 11, 12)
          (local.set $x1 (i32.add (local.get $x1) (local.get $x6)))
          (local.set $x12 (i32.rotl (i32.xor (local.get $x12) (local.get $x1)) (i32.const 16)))
          (local.set $x11 (i32.add (local.get $x11) (local.get $x12)))
          (local.set $x6 (i32.rotl (i32.xor (local.get $x6) (local.get $x11)) (i32.const 12)))
          (local.set $x1 (i32.add (local.get $x1) (local.get $x6)))
          (local.set $x12 (i32.rotl (i32.xor (local.get $x12) (local.get $x1)) (i32.const 8)))
          (local.set $x11 (i32.add (local.get $x11) (local.get $x12)))
          (local.set $x6 (i32.rotl (i32.xor (local.get $x6) (local.get $x11)) (i32.const 7)))
          ;; QR(2, 7, 8, 13)
          (local.set $x2 (i32.add (local.get $x2) (local.get $x7)))
          (local.set $x13 (i32.rotl (i32.xor (local.get $x13) (local.get $x2)) (i32.const 16)))
          (local.set $x8 (i32.add (local.get $x8) (local.get $x13)))
          (local.set $x7 (i32.rotl (i32.xor (local.get $x7) (local.get $x8)) (i32.const 12)))
          (local.set $x2 (i32.add (local.get $x2) (local.get $x7)))
          (local.set $x13 (i32.rotl (i32.xor (local.get $x13) (local.get $x2)) (i32.const 8)))
          (local.set $x8 (i32.add (local.get $x8) (local.get $x13)))
          (local.set $x7 (i32.rotl (i32.xor (local.get $x7) (local.get $x8)) (i32.const 7)))
          ;; QR(3, 4, 9, 14)
          (local.set $x3 (i32.add (local.get $x3) (local.get $x4)))
          (local.set $x14 (i32.rotl (i32.xor (local.get $x14) (local.get $x3)) (i32.const 16)))
          (local.set $x9 (i32.add (local.get $x9) (local.get $x14)))
          (local.set $x4 (i32.rotl (i32.xor (local.get $x4) (local.get $x9)) (i32.const 12)))
          (local.set $x3 (i32.add (local.get $x3) (local.get $x4)))
          (local.set $x14 (i32.rotl (i32.xor (local.get $x14) (local.get $x3)) (i32.const 8)))
          (local.set $x9 (i32.add (local.get $x9) (local.get $x14)))
          (local.set $x4 (i32.rotl (i32.xor (local.get $x4) (local.get $x9)) (i32.const 7)))
          (br_if $round (local.tee $i (i32.sub (local.get $i) (i32.const 1)))))

        (local.set $x0 (i32.add (local.get $x0) (i32.const 0x61707865)))
        (local.set $x1 (i32.add (local.get $x1) (i32.const 0x3320646e)))
        (local.set $x2 (i32.add (local.get $x2) (i32.const 0x79622d32)))
        (local.set $x3 (i32.add (local.get $x3) (i32.const 0x6b206574)))
        (local.set $x4 (i32.add (local.get $x4) (local.get $k0)))
        (local.set $x5 (i32.add (local.get $x5) (local.get $k1)))
        (local.set $x6 (i32.add (local.get $x6) (local.get $k2)))
        (local.set $x7 (i32.add (local.get $x7) (local.get $k3)))
        (local.set $x8 (i32.add (local.get $x8) (local.get $k4)))
        (local.set $x9 (i32.add (local.get $x9) (local.get $k5)))
        (local.set $x10 (i32.add (local.get $x10) (local.get $k6)))
        (local.set $x11 (i32.add (local.get $x11) (local.get $k7)))
        (local.set $x12 (i32.add (local.get $x12) (local.get $counter)))
        (local.set $x14 (i32.add (local.get $x14) (local.get $n0)))
        (local.set $x15 (i32.add (local.get $x15) (local.get $n1)))

        (if (i32.ge_u (i32.sub (local.get $end) (local.get $data)) (i32.const 64))
          (then
            (i32.store (local.get $data) (i32.xor (i32.load (local.get $data)) (local.get $x0)))
            (i32.store offset=4 (local.get $data) (i32.xor (i32.load offset=4 (local.get $data)) (local.get $x1)))
            (i32.store offset=8 (local.get $data) (i32.xor (i32.load offset=8 (local.get $data)) (local.get $x2)))
            (i32.store offset=12 (local.get $data) (i32.xor (i32.load offset=12 (local.get $data)) (local.get $x3)))
            (i32.store offset=16 (local.get $data) (i32.xor (i32.load offset=16 (local.get $data)) (local.get $x4)))
            (i32.store offset=20 (local.get $data) (i32.xor (i32.load offset=20 (local.get $data)) (local.get $x5)))
            (i32.store offset=24 (local.get $data) (i32.xor (i32.load offset=24 (local.get $data)) (local.get $x6)))
            (i32.store offset=28 (local.get $data) (i32.xor (i32.load offset=28 (local.get $data)) (local.get $x7)))
            (i32.store offset=32 (local.get $data) (i32.xor (i32.load offset=32 (local.get $data)) (local.get $x8)))
            (i32.store offset=36 (local.get $data) (i32.xor (i32.load offset=36 (local.get $data)) (local.get $x9)))
            (i32.store offset=40 (local.get $data) (i32.xor (i32.load offset=40 (local.get $data)) (local.get $x10)))
            (i32.store offset=44 (local.get $data) (i32.xor (i32.load offset=44 (local.get $data)) (local.get $x11)))
            (i32.store offset=48 (local.get $data) (i32.xor (i32.load offset=48 (local.get $data)) (local.get $x12)))
            (i32.store offset=52 (local.get $data) (i32.xor (i32.load offset=52 (local.get $data)) (local.get $x13)))
            (i32.store offset=56 (local.get $data) (i32.xor (i32.load offset=56 (local.get $data)) (local.get $x14)))
            (i32.store offset=60 (local.get $data) (i32.xor (i32.load offset=60 (local.get $data)) (local.get $x15)))
            (local.set $data (i32.add (local.get $data) (i32.const 64))))
          (else
            (i32.store (i32.const 0) (local.get $x0))
            (i32.store (i32.const 4) (local.get $x1))
            (i32.store (i32.const 8) (local.get $x2))
            (i32.store (i32.const 12) (local.get $x3))
            (i32.store (i32.const 16) (local.get $x4))
            (i32.store (i32.const 20) (local.get $x5))
            (i32.store (i32.const 24) (local.get $x6))
            (i32.store (i32.const 28) (local.get $x7))
            (i32.store (i32.const 32) (local.get $x8))
            (i32.store (i32.const 36) (local.get $x9))
            (i32.store (i32.const 40) (local.get $x10))
            (i32.store (i32.const 44) (local.get $x11))
            (i32.store (i32.const 48) (local.get $x12))
            (i32.store (i32.const 52) (local.get $x13))
            (i32.store (i32.const 56) (local.get $x14))
            (i32.store (i32.const 60) (local.get $x15))
            (local.set $i (i32.const 0))
            (loop $tail
              (i32.store8 (local.get $data)
                (i32.xor (i32.load8_u (local.get $data)) (i32.load8_u (local.get $i))))
              (local.set $data (i32.add (local.get $data) (i32.const 1)))
              (local.set $i (i32.add (local.get $i) (i32.const 1)))
              (br_if $tail (i32.lt_u (local.get $data) (local.get $end))))))

        (local.set $counter (i32.add (local.get $counter) (i32.const 1)))
        (br $block))))

  ;; Absorbs the 16-byte blocks in [m, end) into the Poly1305 state. hibit is
  ;; 2^24 for a full block, 0 for the padded last one.
  (func $blocks (param $m i32) (param $end i32) (param $hibit i64)
    (local $r0 i64) (local $r1 i64) (local $r2 i64) (local $r3 i64) (local $r4 i64)
    (local $s1 i64) (local $s2 i64) (local $s3 i64) (local $s4 i64)
    (local $h0 i64) (local $h1 i64) (local $h2 i64) (local $h3 i64) (local $h4 i64)
    (local $d0 i64) (local $d1 i64) (local $d2 i64) (local $d3 i64) (local $d4 i64)
    (local $c i64)

    (local.set $r0 (global.get $r0))
    (local.set $r1 (global.get $r1))
    (local.set $r2 (global.get $r2))
    (local.set $r3 (global.get $r3))
    (local.set $r4 (global.get $r4))
    (local.set $s1 (i64.mul (local.get $r1) (i64.const 5)))
    (local.set $s2 (i64.mul (local.get $r2) (i64.const 5)))
    (local.set $s3 (i64.mul (local.get $r3) (i64.const 5)))
    (local.set $s4 (i64.mul (local.get $r4) (i64.const 5)))
    (local.set $h0 (global.get $h0))
    (local.set $h1 (global.get $h1))
    (local.set $h2 (global.get $h2))
    (local.set $h3 (global.get $h3))
    (local.set $h4 (global.get $h4))

    (block $done
      (loop $block
        (br_if $done (i32.ge_u (local.get $m) (local.get $end)))

        ;; h += m
        (local.set $h0 (i64.add (local.get $h0)
          (i64.and (i64.load32_u (local.get $m)) (i64.const 0x3ffffff))))
        (local.set $h1 (i64.add (local.get $h1)
          (i64.and (i64.shr_u (i64.load32_u offset=3 (local.get $m)) (i64.const 2)) (i64.const 0x3ffffff))))
        (local.set $h2 (i64.add (local.get $h2)
          (i64.and (i64.shr_u (i64.load32_u offset=6 (local.get $m)) (i64.const 4)) (i64.const 0x3ffffff))))
        (local.set $h3 (i64.add (local.get $h3)
          (i64.and (i64.shr_u (i64.load32_u offset=9 (local.get $m)) (i64.const 6)) (i64.const 0x3ffffff))))
        (local.set $h4 (i64.add (local.get $h4)
          (i64.or (i64.shr_u (i64.load32_u offset=12 (local.get $m)) (i64.const 8)) (local.get $hibit))))

        ;; h *= r
        (local.set $d0 (i64.add (i64.add (i64.add (i64.add
          (i64.mul (local.get $h0) (local.get $r0))
          (i64.mul (local.get $h1) (local.get $s4)))
          (i64.mul (local.get $h2) (local.get $s3)))
          (i64.mul (local.get $h3) (local.get $s2)))
          (i64.mul (local.get $h4) (local.get $s1))))
        (local.set $d1 (i64.add (i64.add (i64.add (i64.add
          (i64.mul (local.get $h0) (local.get $r1))
          (i64.mul (local.get $h1) (local.get $r0)))
          (i64.mul (local.get $h2) (local.get $s4)))
          (i64.mul (local.get $h3) (local.get $s3)))
          (i64.mul (local.get $h4) (local.get $s2))))
        (local.set $d2 (i64.add (i64.add (i64.add (i64.add
          (i64.mul (local.get $h0) (local.get $r2))
          (i64.mul (local.get $h1) (local.get $r1)))
          (i64.mul (local.get $h2) (local.get $r0)))
          (i64.mul (local.get $h3) (local.get $s4)))
          (i64.mul (local.get $h4) (local.get $s3))))
        (local.set $d3 (i64.add (i64.add (i64.add (i64.add
          (i64.mul (local.get $h0) (local.get $r3))
          (i64.mul (local.get $h1) (local.get $r2)))
          (i64.mul (local.get $h2) (local.get $r1)))
          (i64.mul (local.get $h3) (local.get $r0)))
          (i64.mul (local.get $h4) (local.get $s4))))
        (local.set $d4 (i64.add (i64.add (i64.add (i64.add
          (i64.mul (local.get $h0) (local.get $r4))
          (i64.mul (local.get $h1) (local.get $r3)))
          (i64.mul (local.get $h2) (local.get $r2)))
          (i64.mul (local.get $h3) (local.get $r1)))
          (i64.mul (local.get $h4) (local.get $r0))))

        ;; partial reduction mod 2^130 - 5
        (local.set $c (i64.shr_u (local.get $d0) (i64.const 26)))
        (local.set $h0 (i64.and (local.get $d0) (i64.const 0x3ffffff)))
        (local.set $d1 (i64.add (local.get $d1) (local.get $c)))
        (local.set $c (i64.shr_u (local.get $d1) (i64.const 26)))
        (local.set $h1 (i64.and (local.get $d1) (i64.const 0x3ffffff)))
        (local.set $d2 (i64.add (local.get $d2) (local.get $c)))
        (local.set $c (i64.shr_u (local.get $d2) (i64.const 26)))
        (local.set $h2 (i64.and (local.get $d2) (i64.const 0x3ffffff)))
        (local.set $d3 (i64.add (local.get $d3) (local.get $c)))
        (local.set $c (i64.shr_u (local.get $d3) (i64.const 26)))
        (local.set $h3 (i64.and (local.get $d3) (i64.const 0x3ffffff)))
        (local.set $d4 (i64.add (local.get $d4) (local.get $c)))
        (local.set $c (i64.shr_u (local.get $d4) (i64.const 26)))
        (local.set $h4 (i64.and (local.get $d4) (i64.const 0x3ffffff)))
        (local.set $h0 (i64.add (local.get $h0) (i64.mul (local.get $c) (i64.const 5))))
        (local.set $c (i64.shr_u (local.get $h0) (i64.const 26)))
        (local.set $h0 (i64.and (local.get $h0) (i64.const 0x3ffffff)))
        (local.set $h1 (i64.add (local.get $h1) (local.get $c)))

        (local.set $m (i32.add (local.get $m) (i32.const 16)))
        (br $block)))

    (global.set $h0 (local.get $h0))
    (global.set $h1 (local.get $h1))
    (global.set $h2 (local.get $h2))
    (global.set $h3 (local.get $h3))
    (global.set $h4 (local.get $h4)))

  ;; Writes the 16-byte Poly1305 tag of the len bytes at msg under the 32-byte
  ;; one-time key at key to out. A partial last block is padded in scratch
  ;; bytes 0-15, so the bytes after msg are left alone.
  (func (export "poly1305") (param $key i32) (param $msg i32) (param $len i32) (param $out i32)
    (local $full i32) (local $rem i32) (local $i i32)
    (local $h0 i64) (local $h1 i64) (local $h2 i64) (local $h3 i64) (local $h4 i64)
    (local $g0 i64) (local $g1 i64) (local $g2 i64) (local $g3 i64) (local $g4 i64)
    (local $c i64) (local $mask i64) (local $f i64)

    ;; r = key[0..16], clamped
    (global.set $r0 (i64.and (i64.load32_u (local.get $key)) (i64.const 0x3ffffff)))
    (global.set $r1 (i64.and (i64.shr_u (i64.load32_u offset=3 (local.get $key)) (i64.const 2)) (i64.const 0x3ffff03)))
    (global.set $r2 (i64.and (i64.shr_u (i64.load32_u offset=6 (local.get $key)) (i64.const 4)) (i64.const 0x3ffc0ff)))
    (global.set $r3 (i64.and (i64.shr_u (i64.load32_u offset=9 (local.get $key)) (i64.const 6)) (i64.const 0x3f03fff)))
    (global.set $r4 (i64.and (i64.shr_u (i64.load32_u offset=12 (local.get $key)) (i64.const 8)) (i64.const 0x00fffff)))
    (global.set $h0 (i64.const 0))
    (global.set $h1 (i64.const 0))
    (global.set $h2 (i64.const 0))
    (global.set $h3 (i64.const 0))
    (global.set $h4 (i64.const 0))

    (local.set $full (i32.add (local.get $msg) (i32.and (local.get $len) (i32.const -16))))
    (call $blocks (local.get $msg) (local.get $full) (i64.const 0x1000000))

    (local.set $rem (i32.and (local.get $len) (i32.const 15)))
    (if (local.get $rem)
      (then
        (i64.store (i32.const 0) (i64.const 0))
        (i64.store (i32.const 8) (i64.const 0))
        (local.set $i (i32.const 0))
        (loop $copy
          (i32.store8 (local.get $i) (i32.load8_u (i32.add (local.get $full) (local.get $i))))
          (br_if $copy (i32.lt_u (local.tee $i (i32.add (local.get $i) (i32.const 1))) (local.get $rem))))
        (i32.store8 (local.get $rem) (i32.const 1))
        (call $blocks (i32.const 0) (i32.const 16) (i64.const 0))))

    ;; fully carry h
    (local.set $h0 (global.get $h0))
    (local.set $h1 (global.get $h1))
    (local.set $h2 (global.get $h2))
    (local.set $h3 (global.get $h3))
    (local.set $h4 (global.get $h4))
    (local.set $c (i64.shr_u (local.get $h1) (i64.const 26)))
    (local.set $h1 (i64.and (local.get $h1) (i64.const 0x3ffffff)))
    (local.set $h2 (i64.add (local.get $h2) (local.get $c)))
    (local.set $c (i64.shr_u (local.get $h2) (i64.const 26)))
    (local.set $h2 (i64.and (local.get $h2) (i64.const 0x3ffffff)))
    (local.set $h3 (i64.add (local.get $h3) (local.get $c)))
    (local.set $c (i64.shr_u (local.get $h3) (i64.const 26)))
    (local.set $h3 (i64.and (local.get $h3) (i64.const 0x3ffffff)))
    (local.set $h4 (i64.add (local.get $h4) (local.get $c)))
    (local.set $c (i64.shr_u (local.get $h4) (i64.const 26)))
    (local.set $h4 (i64.and (local.get $h4) (i64.const 0x3ffffff)))
    (local.set $h0 (i64.add (local.get $h0) (i64.mul (local.get $c) (i64.const 5))))
    (local.set $c (i64.shr_u (local.get $h0) (i64.const 26)))
    (local.set $h0 (i64.and (local.get $h0) (i64.const 0x3ffffff)))
    (local.set $h1 (i64.add (local.get $h1) (local.get $c)))

    ;; g = h + -p
    (local.set $g0 (i64.add (local.get $h0) (i64.const 5)))
    (local.set $c (i64.shr_u (local.get $g0) (i64.const 26)))
    (local.set $g0 (i64.and (local.get $g0) (i64.const 0x3ffffff)))
    (local.set $g1 (i64.add (local.get $h1) (local.get $c)))
    (local.set $c (i64.shr_u (local.get $g1) (i64.const 26)))
    (local.set $g1 (i64.and (local.get $g1) (i64.const 0x3ffffff)))
    (local.set $g2 (i64.add (local.get $h2) (local.get $c)))
    (local.set $c (i64.shr_u (local.get $g2) (i64.const 26)))
    (local.set $g2 (i64.and (local.get $g2) (i64.const 0x3ffffff)))
    (local.set $g3 (i64.add (local.get $h3) (local.get $c)))
    (local.set $c (i64.shr_u (local.get $g3) (i64.const 26)))
    (local.set $g3 (i64.and (local.get $g3) (i64.const 0x3ffffff)))
    (local.set $g4 (i64.sub (i64.add (local.get $h4) (local.get $c)) (i64.const 0x4000000)))

    ;; h = h < p ? h : g, without a branch
    (local.set $mask (i64.sub (i64.shr_u (local.get $g4) (i64.const 63)) (i64.const 1)))
    (local.set $h0 (i64.or (i64.and (local.get $h0) (i64.xor (local.get $mask) (i64.const -1))) (i64.and (local.get $g0) (local.get $mask))))
    (local.set $h1 (i64.or (i64.and (local.get $h1) (i64.xor (local.get $mask) (i64.const -1))) (i64.and (local.get $g1) (local.get $mask))))
    (local.set $h2 (i64.or (i64.and (local.get $h2) (i64.xor (local.get $mask) (i64.const -1))) (i64.and (local.get $g2) (local.get $mask))))
    (local.set $h3 (i64.or (i64.and (local.get $h3) (i64.xor (local.get $mask) (i64.const -1))) (i64.and (local.get $g3) (local.get $mask))))
    (local.set $h4 (i64.or (i64.and (local.get $h4) (i64.xor (local.get $mask) (i64.const -1))) (i64.and (local.get $g4) (local.get $mask))))

    ;; h %= 2^128, as four 32-bit words
    (local.set $h0 (i64.and (i64.or (local.get $h0) (i64.shl (local.get $h1) (i64.const 26))) (i64.const 0xffffffff)))
    (local.set $h1 (i64.and (i64.or (i64.shr_u (local.get $h1) (i64.const 6)) (i64.shl (local.get $h2) (i64.const 20))) (i64.const 0xffffffff)))
    (local.set $h2 (i64.and (i64.or (i64.shr_u (local.get $h2) (i64.const 12)) (i64.shl (local.get $h3) (i64.const 14))) (i64.const 0xffffffff)))
    (local.set $h3 (i64.and (i64.or (i64.shr_u (local.get $h3) (i64.const 18)) (i64.shl (local.get $h4) (i64.const 8))) (i64.const 0xffffffff)))

    ;; tag = (h + s) % 2^128, s = key[16..32]
    (local.set $f (i64.add (local.get $h0) (i64.load32_u offset=16 (local.get $key))))
    (i64.store32 (local.get $out) (local.get $f))
    (local.set $f (i64.add (i64.add (local.get $h1) (i64.load32_u offset=20 (local.get $key))) (i64.shr_u (local.get $f) (i64.const 32))))
    (i64.store32 offset=4 (local.get $out) (local.get $f))
    (local.set $f (i64.add (i64.add (local.get $h2) (i64.load32_u offset=24 (local.get $key))) (i64.shr_u (local.get $f) (i64.const 32))))
    (i64.store32 offset=8 (local.get $out) (local.get $f))
    (local.set $f (i64.add (i64.add (local.get $h3) (i64.load32_u offset=28 (local.get $key))) (i64.shr_u (local.get $f) (i64.const 32))))
    (i64.store32 offset=12 (local.get $out) (local.get $f))))
